{
  "name": "helpa",
  "version": "0.3.0",
  "private": true,
  "description": "Helpa — WhatsApp AI Receptionist & Patient Engagement CRM for Clinics and Hospitals. Built on Next.js 16 and Appwrite.",
  "license": "MIT",
  "author": "Susanta Lohar",
  "homepage": "https://github.com/imsusanta/wacrm_susanta",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/imsusanta/wacrm_susanta.git"
  },
  "bugs": {
    "url": "https://github.com/imsusanta/wacrm_susanta/issues"
  },
  "keywords": [
    "crm",
    "whatsapp",
    "whatsapp-business-api",
    "healthcare",
    "clinic",
    "ai-receptionist",
    "nextjs",
    "appwrite",
    "appointment-booking",
    "digital-prescriptions",
    "opd-ticket"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "worker": "tsx scripts/worker.ts",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --exclude='**/src/tests/integration/**'",
    "test:watch": "vitest --exclude='**/src/tests/integration/**'",
    "test:integration": "vitest run src/tests/tenant-isolation.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "appwrite:setup": "tsx scripts/setup-appwrite-db.ts --apply",
    "appwrite:verify": "tsx scripts/verify-appwrite-db.ts && tsx scripts/verify-appwrite-storage.ts",
    "appwrite:migrate:dry-run": "tsx scripts/setup-appwrite-db.ts --dry-run",
    "appwrite:migrate:apply": "tsx scripts/setup-appwrite-db.ts --apply",
    "appwrite:test": "vitest run src/tests/appwrite/**/*.test.ts",
    "appwrite:migrate": "tsx scripts/setup-appwrite-db.ts --dry-run",
    "voice:smoke": "tsx scripts/voice-smoke-test.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@dagrejs/dagre": "^3.0.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@types/qrcode": "^1.5.6",
    "@xyflow/react": "^12.11.0",
    "appwrite": "^26.2.0",
    "bullmq": "^5.41.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "framer-motion": "^13.0.0",
    "ioredis": "^5.5.0",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.18.0",
    "next": "16.3.0",
    "node-appwrite": "^27.1.0",
    "opus-recorder": "^8.0.5",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.10.1",
    "shadcn": "^4.11.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^25",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "prettier": "^3.8.4",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tailwindcss": "^4",
    "tsx": "^4.19.2",
    "typescript": "^6",
    "vitest": "^4.1.9"
  },
  "overrides": {
    "postcss": "^8.5.26",
    "nanoid": "^3.3.18",
    "ip-address": "^10.4.0",
    "fast-uri": "^3.1.3",
    "hono": "^4.12.34",
    "js-yaml": "^4.3.1",
    "@hono/node-server": "^2.1.0",
    "dompurify": "^3.4.13",
    "brace-expansion": "^2.0.2",
    "@babel/core": "^7.29.6"
  }
}
