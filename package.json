{
  "name": "helpa",
  "version": "0.3.0",
  "private": true,
  "description": "Helpa — WhatsApp AI Receptionist & Patient Engagement CRM for Clinics and Hospitals. Built on Next.js 16 and Supabase.",
  "license": "MIT",
  "author": "Susanta Lohar",
  "homepage": "https://github.com/imsusanta/helpa",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/imsusanta/helpa.git"
  },
  "bugs": {
    "url": "https://github.com/imsusanta/helpa/issues"
  },
  "keywords": [
    "crm",
    "whatsapp",
    "whatsapp-business-api",
    "healthcare",
    "clinic",
    "ai-receptionist",
    "nextjs",
    "supabase",
    "appointment-booking",
    "digital-prescriptions",
    "opd-ticket"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/generate-build-metadata.mjs",
    "build": "next build",
    "start": "next start",
    "worker": "tsx scripts/worker.ts",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css}\" \"scripts/**/*.{ts,js,mjs}\" \"*.{json,ts,mjs,js}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,css}\" \"scripts/**/*.{ts,js,mjs}\" \"*.{json,ts,mjs,js}\"",
    "test": "vitest run --exclude='**/src/tests/integration/**'",
    "test:watch": "vitest --exclude='**/src/tests/integration/**'",
    "test:integration": "vitest run src/tests/tenant-isolation.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "voice:smoke": "tsx scripts/voice-smoke-test.ts",
    "verify:whatsapp-live": "node scripts/verify-whatsapp-live.mjs",
    "supabase:migrate": "node scripts/apply-supabase-migrations.mjs",
    "supabase:validate": "node scripts/validate-supabase-migrations.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@dagrejs/dagre": "^3.0.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.3",
    "@types/qrcode": "^1.5.6",
    "@xyflow/react": "^12.11.0",
    "appwrite": "^26.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "framer-motion": "^13.1.0",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.18.0",
    "next": "16.3.0",
    "node-appwrite": "^28.0.0",
    "opus-recorder": "^8.0.5",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.10.1",
    "shadcn": "^4.18.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^25",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.20.0",
    "eslint-config-next": "16.3.1",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5.8.2",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "postcss": "^8.5.26",
    "nanoid": "^3.3.18",
    "ip-address": "^10.4.0",
    "fast-uri": "^3.1.0",
    "hono": "^4.12.34",
    "@hono/node-server": "^2.1.0",
    "dompurify": "^3.4.13",
    "@babel/core": "^7.29.6"
  }
}
