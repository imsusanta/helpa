# Canonical production provider selection. These are server-only switches.
AUTH_PROVIDER=supabase
DATABASE_PROVIDER=supabase
MIGRATION_MODE=cutover

# Supabase: URL and publishable key may be exposed to the browser; the service
# role key is server-only and must never use a NEXT_PUBLIC_ prefix.
NEXT_PUBLIC_SUPABASE_URL=https://zsxhtcprjllesptvxlyq.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROJECT_REF=zsxhtcprjllesptvxlyq
SUPABASE_DB_PASSWORD=

# Token encryption key for AES-256-GCM (64 hex characters = 32 bytes).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WHATSAPP_TOKEN_ENCRYPTION_KEY=
ENCRYPTION_KEY=
# Shared rate-limit counter across serverless instances. Optional in
# single-node local dev (falls back to in-memory). Required in production.
REDIS_URL=

# -------------------------------------------------------------
# Meta WhatsApp Business API & Embedded Signup
# -------------------------------------------------------------
# PUBLIC (Frontend):
NEXT_PUBLIC_META_APP_ID=
NEXT_PUBLIC_META_CONFIG_ID=

# SERVER-ONLY (Never expose to client or prefix with NEXT_PUBLIC_):
META_APP_ID=
META_APP_SECRET=
META_CONFIG_ID=
META_WEBHOOK_VERIFY_TOKEN=

# ElevenLabs (server-only; omit until the provider is configured).
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_PHONE_NUMBER_ID=
ELEVENLABS_WEBHOOK_SECRET=
ELEVENLABS_BASE_URL=https://api.elevenlabs.io/v1

# Providers not implemented until their official telephony APIs are available.
SARVAM_API_KEY=
SARVAM_AGENT_ID=
SARVAM_PHONE_NUMBER_ID=
SARVAM_WEBHOOK_SECRET=
XAI_API_KEY=
XAI_VOICE_AGENT_ID=
XAI_PHONE_NUMBER_ID=
XAI_WEBHOOK_SECRET=

# Evolution Go v0.7.2 (server-only; never prefix with NEXT_PUBLIC_)
EVOLUTION_GO_BASE_URL=
EVOLUTION_GO_GLOBAL_API_KEY=
EVOLUTION_GO_WEBHOOK_BASE_URL=
# Optional. Per-request timeout 3000–120000 (default 30000; 6500 on Vercel).
# EVOLUTION_GO_TIMEOUT_MS=6500
# Optional. Whole QR session budget 3000–120000 (default 8000 on Vercel).
# EVOLUTION_GO_SESSION_BUDGET_MS=8000
