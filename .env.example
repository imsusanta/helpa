# Canonical production provider selection. These are server-only switches.
AUTH_PROVIDER=supabase
DATABASE_PROVIDER=supabase
MIGRATION_MODE=cutover

# Supabase: URL and publishable key may be exposed to the browser; the service
# role key is server-only and must never use a NEXT_PUBLIC_ prefix.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROJECT_REF=your-project-ref
SUPABASE_DB_PASSWORD=

ENCRYPTION_KEY=
REDIS_URL=

# Meta WhatsApp Business API & Embedded Signup
NEXT_PUBLIC_META_APP_ID=
META_APP_ID=
META_APP_SECRET=
NEXT_PUBLIC_META_CONFIG_ID=
META_CONFIG_ID=

# ElevenLabs (server-only; omit until the provider is configured).
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_PHONE_NUMBER_ID=
ELEVENLABS_WEBHOOK_SECRET=
ELEVENLABS_BASE_URL=https://api.elevenlabs.io/v1

# Providers not implemented until their official telephony APIs are available.
SARVAM_API_KEY=
SARVAM_AGENT_ID=
SARVAM_PHONE_NUMBER_ID=
SARVAM_WEBHOOK_SECRET=
XAI_API_KEY=
XAI_VOICE_AGENT_ID=
XAI_PHONE_NUMBER_ID=
XAI_WEBHOOK_SECRET=
