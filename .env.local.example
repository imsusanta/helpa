# ============================================================
# REQUIRED — the app won't start without these.
# ============================================================

# Appwrite Cloud or Self-Hosted Settings
NEXT_PUBLIC_APPWRITE_ENDPOINT=https://sgp.cloud.appwrite.io/v1
NEXT_PUBLIC_APPWRITE_PROJECT_ID=your-appwrite-project-id
NEXT_PUBLIC_APPWRITE_DATABASE_ID=helpa_main
APPWRITE_API_KEY=your-appwrite-server-api-key
APPWRITE_DATABASE_ID=helpa_main

# Token encryption (64 hex chars = 32 bytes, AES-256-GCM).
ENCRYPTION_KEY=your-64-char-hex-key-here

# HMAC key for public appointment PDF links.
PDF_SIGNING_KEY=your-pdf-signing-key

# Meta App Secret (Meta for Developers → App Settings → Basic).
META_APP_SECRET=your-meta-app-secret

# Redis is required by the persistent BullMQ worker and enqueue-only routes.
REDIS_URL=redis://default:password@redis.example.com:6379

# Header-only secret protecting production cron routes such as reminders.
CRON_SECRET=generate-a-long-random-string

# ============================================================
# RECOMMENDED — safe defaults exist but you'll want to set these.
# ============================================================
NEXT_PUBLIC_SITE_URL=https://crm.example.com

# Voice provider settings (server-only; never prefix these with NEXT_PUBLIC_).
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_PHONE_NUMBER_ID=
ELEVENLABS_WEBHOOK_SECRET=
ELEVENLABS_BASE_URL=https://api.elevenlabs.io/v1
SARVAM_API_KEY=
SARVAM_AGENT_ID=
SARVAM_PHONE_NUMBER_ID=
SARVAM_WEBHOOK_SECRET=
XAI_API_KEY=
XAI_VOICE_AGENT_ID=
XAI_PHONE_NUMBER_ID=
XAI_WEBHOOK_SECRET=
