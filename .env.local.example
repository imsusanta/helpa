NEXT_PUBLIC_META_CONFIG_ID=your-meta-config-id
META_APP_ID=your-meta-app-id
META_APP_SECRET=your-meta-app-secret
META_CONFIG_ID=your-meta-config-id
META_WEBHOOK_VERIFY_TOKEN=your-custom-webhook-verify-token

REDIS_URL=redis://default:password@redis.example.com:6379
